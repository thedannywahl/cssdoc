{
  "name": "@cssdoc/html",
  "version": "0.20.1",
  "description": "Emit standalone, self-contained HTML reference pages from the cssdoc model — one page per record plus an index.",
  "keywords": [
    "css",
    "cssdoc",
    "documentation",
    "emitter",
    "html"
  ],
  "homepage": "https://cssdoc.dev",
  "bugs": "https://github.com/thedannywahl/cssdoc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/cssdoc.git",
    "directory": "emitters/html"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@cssdoc/core": "workspace:*",
    "@cssdoc/dialects": "workspace:*",
    "@cssdoc/embedded": "workspace:*",
    "@cssdoc/index": "workspace:*",
    "@cssdoc/regex": "workspace:*",
    "hast-util-sanitize": "catalog:",
    "hast-util-to-html": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-to-hast": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
