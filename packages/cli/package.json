{
  "name": "@cssdoc/cli",
  "version": "0.15.2",
  "description": "A host-agnostic `cssdoc lint` command line — the @cssdoc/lint-core rules with no ESLint or Stylelint required.",
  "keywords": [
    "cli",
    "css",
    "cssdoc",
    "documentation",
    "lint"
  ],
  "homepage": "https://cssdoc.dev",
  "bugs": "https://github.com/thedannywahl/cssdoc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/cssdoc.git",
    "directory": "packages/cli"
  },
  "bin": {
    "cssdoc": "./bin/cssdoc.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "publint": "publint"
  },
  "dependencies": {
    "@bomb.sh/tab": "catalog:",
    "@clack/prompts": "catalog:",
    "@commander-js/extra-typings": "catalog:",
    "@cssdoc/config": "workspace:*",
    "@cssdoc/core": "workspace:*",
    "@cssdoc/index": "workspace:*",
    "@cssdoc/lint-core": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
