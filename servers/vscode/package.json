{
  "name": "cssdoc-vscode",
  "displayName": "cssdoc",
  "version": "0.13.10",
  "private": true,
  "description": "VS Code support for cssdoc: completions, hover, go-to-definition, and deprecation quick-fixes for documented CSS classes, modifiers, and custom properties.",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "homepage": "https://cssdoc.dev",
  "bugs": "https://github.com/thedannywahl/cssdoc/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/cssdoc.git",
    "directory": "servers/vscode"
  },
  "publisher": "cssdoc",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "vp check",
    "test": "vp test",
    "icon": "node scripts/gen-icon.mjs",
    "package": "vp run -t build && vsce package --no-dependencies -o cssdoc.vsix"
  },
  "dependencies": {
    "@cssdoc/config": "workspace:*",
    "@cssdoc/language-server": "workspace:*",
    "vscode-languageclient": "catalog:"
  },
  "devDependencies": {
    "@resvg/resvg-js": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "ovsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "text.cssdoc",
        "path": "./syntaxes/cssdoc.injection.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.scss",
          "source.less",
          "source.css.styled",
          "source.ts",
          "source.tsx",
          "source.js",
          "source.jsx",
          "source.vue",
          "source.svelte",
          "source.astro",
          "text.html.markdown",
          "text.html.basic",
          "text.html.derivative"
        ]
      },
      {
        "scopeName": "source.css.cssdoc.atrules",
        "path": "./syntaxes/cssdoc.atrules.injection.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.scss",
          "source.less",
          "source.css.styled",
          "source.ts",
          "source.tsx",
          "source.js",
          "source.jsx",
          "source.vue",
          "source.svelte",
          "source.astro",
          "text.html.markdown",
          "text.html.basic",
          "text.html.derivative"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "cssdoc.json",
          "cssdoc.jsonc"
        ],
        "url": "./schemas/cssdoc.schema.json"
      }
    ],
    "configuration": {
      "title": "cssdoc",
      "properties": {
        "cssdoc.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.css"
          ],
          "markdownDescription": "Globs for the documented CSS the language server reads. Auto-detects all CSS in the workspace by default."
        },
        "cssdoc.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**"
          ],
          "markdownDescription": "Globs excluded from `#cssdoc.include#` auto-detection."
        },
        "cssdoc.css": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Explicit paths to documented CSS files. When set, this overrides `#cssdoc.include#` / `#cssdoc.exclude#` auto-detection.",
          "markdownDeprecationMessage": "Prefer `#cssdoc.include#` / `#cssdoc.exclude#`. This explicit list still works and takes precedence when non-empty."
        },
        "cssdoc.hover.detail": {
          "type": "string",
          "enum": [
            "compact",
            "full",
            "custom"
          ],
          "enumDescriptions": [
            "Header, summary, deprecation, and a facet count line.",
            "Every section that has content, each listed with its description (empty sections are omitted).",
            "Per-section visibility, from `#cssdoc.hover.sections#`."
          ],
          "default": "full",
          "markdownDescription": "How much detail a documented component's hover card shows. Use `custom` to control each section via `#cssdoc.hover.sections#`."
        },
        "cssdoc.hover.sections": {
          "type": "object",
          "markdownDescription": "Per-section visibility when `#cssdoc.hover.detail#` is `custom`. Each value is `auto` (show only when the section has content — what `full` does), `on` (always show; empty renders a placeholder), or `off` (hide). Keys: `summary`, `deprecated`, `remarks`, `accessibility`, `modifiers`, `parts`, `shadowParts`, `states`, `customProperties`, `functions`, `slots`, `animations`, `layers`, `conditions`, `see`, `structure`, `examples`. Unlisted sections default to `auto`.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "auto",
              "on",
              "off"
            ]
          },
          "default": {}
        },
        "cssdoc.hover.sectionOrder": {
          "type": "array",
          "markdownDescription": "The order sections appear in a component's hover card. List section keys in the order you want; any section you omit is dropped from the card. Leave empty to use the default order. The header (name, kind, release stage, since) always leads.",
          "items": {
            "type": "string",
            "enum": [
              "summary",
              "deprecated",
              "remarks",
              "accessibility",
              "modifiers",
              "parts",
              "shadowParts",
              "states",
              "customProperties",
              "functions",
              "slots",
              "animations",
              "layers",
              "conditions",
              "see",
              "structure",
              "examples"
            ]
          },
          "default": []
        },
        "cssdoc.editor.providerDiscovery": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable automatic scanning of `cssdoc.json` files in the workspace for provider entries (CSS files declared in the `providers` config field)."
        },
        "cssdoc.editor.providerScanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "markdownDescription": "Maximum directory depth to scan for `cssdoc.json` files relative to the workspace root. Set to `0` to scan only the root."
        },
        "cssdoc.editor.providerGlobs": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Expand glob patterns in provider paths (e.g., `generated/*.css`). When `false`, only exact file paths are used."
        },
        "cssdoc.editor.circularReferenceMode": {
          "type": "string",
          "enum": [
            "first",
            "last",
            "ignore",
            "warn",
            "error"
          ],
          "default": "warn",
          "markdownDescription": "How to handle circular provider references: `first` (use first occurrence in dependency tree), `last` (use last), `ignore` (skip silently), `warn` (log and continue), `error` (fail fast)."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:astro",
    "onLanguage:css",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:less",
    "onLanguage:markdown",
    "onLanguage:scss",
    "onLanguage:svelte",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "configurationDefaults": {
    "[css]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[scss]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[less]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[html]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[vue]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[svelte]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[astro]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[markdown]": {
      "editor.quickSuggestions": {
        "comments": "on"
      }
    },
    "[javascript]": {
      "editor.quickSuggestions": {
        "comments": "on",
        "strings": "on"
      }
    },
    "[javascriptreact]": {
      "editor.quickSuggestions": {
        "comments": "on",
        "strings": "on"
      }
    },
    "[typescript]": {
      "editor.quickSuggestions": {
        "comments": "on",
        "strings": "on"
      }
    },
    "[typescriptreact]": {
      "editor.quickSuggestions": {
        "comments": "on",
        "strings": "on"
      }
    }
  }
}
