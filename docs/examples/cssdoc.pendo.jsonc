{
  "$schema": "https://cssdoc.dev/cssdoc.schema.json",
  // Components target Pendo's immutable HTML via attribute selectors, not RSCSS classes.
  "modifierConvention": "bare",
  "rules": {
    // Component names are Pendo-assigned and don't follow a case convention.
    "component-name-case": "off",
    // @selector / @part declare the selectors explicitly; drift detection isn't useful here.
    "name-not-in-css": "off",
  },
}
