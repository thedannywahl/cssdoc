{
  "name": "cssdoc",
  "version": "0.20.1",
  "private": true,
  "description": "A documentation toolchain for plain CSS — TSDoc, for CSS.",
  "homepage": "https://cssdoc.dev",
  "bugs": "https://github.com/thedannywahl/cssdoc/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/cssdoc.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp run setup"
  },
  "dependencies": {
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@types/node": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@e18e/eslint-plugin": "catalog:",
    "@eslint/json": "catalog:",
    "bumpp": "catalog:",
    "changelogen": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "eslint-plugin-tsdoc-require-2": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitepress-plugin-mermaid": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
