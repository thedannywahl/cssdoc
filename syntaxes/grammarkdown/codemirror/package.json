{
  "name": "@cssdoc/grammarkdown-codemirror",
  "version": "0.19.0",
  "description": "A CodeMirror 6 highlighter for grammarkdown grammar notation.",
  "keywords": [
    "codemirror",
    "codemirror6",
    "editor",
    "grammar",
    "grammarkdown",
    "syntax-highlighting"
  ],
  "homepage": "https://cssdoc.dev",
  "bugs": "https://github.com/thedannywahl/cssdoc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/cssdoc.git",
    "directory": "syntaxes/grammarkdown/codemirror"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "publint": "publint"
  },
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@cssdoc/grammarkdown-tmlanguage": "workspace:*",
    "@cssdoc/regex": "workspace:*",
    "arkregex": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
