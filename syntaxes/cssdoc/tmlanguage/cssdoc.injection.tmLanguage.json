{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cssdoc",
  "scopeName": "text.cssdoc",
  "injectionSelector": "L:comment.block.css, L:comment.block.scss, L:comment.block.less",
  "patterns": [
    {
      "include": "#inline-tag"
    },
    {
      "include": "#record-tag"
    },
    {
      "include": "#modifier-tag"
    },
    {
      "include": "#part-tag"
    },
    {
      "include": "#property-tag"
    },
    {
      "include": "#ref-tag"
    },
    {
      "include": "#state-tag"
    },
    {
      "include": "#structure-tag"
    },
    {
      "include": "#block-tag"
    },
    {
      "include": "#custom-property"
    }
  ],
  "repository": {
    "inline-tag": {
      "name": "meta.inline-tag.cssdoc",
      "begin": "(\\{)(@(?:link|inheritDoc|label))\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.cssdoc"
        },
        "2": {
          "name": "storage.type.class.cssdoc"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.cssdoc"
        }
      },
      "patterns": [
        {
          "match": "\\|",
          "name": "punctuation.separator.cssdoc"
        },
        {
          "match": "[^}|]+",
          "name": "markup.underline.link.cssdoc"
        }
      ]
    },
    "record-tag": {
      "match": "(@(?:component|name|utility|rule|declaration|layout))\\b[ \\t]*([A-Za-z][A-Za-z0-9\\-_]*(?:\\.[A-Za-z][A-Za-z0-9\\-_]*)*)?",
      "captures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        },
        "2": {
          "name": "entity.name.type.cssdoc"
        }
      }
    },
    "modifier-tag": {
      "match": "(@(?:modifier))\\b[ \\t]*(-?[A-Za-z][A-Za-z0-9\\-_]*)?",
      "captures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        },
        "2": {
          "name": "entity.other.attribute-name.part.cssdoc"
        }
      }
    },
    "state-tag": {
      "match": "(@(?:cssstate))\\b[ \\t]*(:?[A-Za-z][A-Za-z0-9\\-_]*(?:\\([A-Za-z0-9\\-_]*\\))?)?",
      "captures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        },
        "2": {
          "name": "support.type.custom-property.cssdoc"
        }
      }
    },
    "part-tag": {
      "match": "(@(?:part|csspart|wrapper|slot|selector|class|pseudo))\\b[ \\t]*(\\.?[A-Za-z][A-Za-z0-9\\-_]*)?",
      "captures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        },
        "2": {
          "name": "entity.other.attribute-name.part.cssdoc"
        }
      }
    },
    "property-tag": {
      "match": "(@(?:cssproperty|property|tokens))\\b[ \\t]*(--[A-Za-z][A-Za-z0-9\\-_]*)?",
      "captures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        },
        "2": {
          "name": "support.type.custom-property.cssdoc"
        }
      }
    },
    "ref-tag": {
      "match": "(@(?:ref))\\b[ \\t]*([0-9]+\\.?)?",
      "captures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        },
        "2": {
          "name": "constant.numeric.cssdoc"
        }
      }
    },
    "block-tag": {
      "match": "(@(?:summary|stage|visibility|remarks|privateRemarks|todo|deprecated|example|see|since|group|category|defaultValue|annotations|ref|readonly|global|interaction|alias|preventExtensions|noextend|sealed|frozen|function|keyframes|animation|layer|container|supports|media|responsive|a11y|accessibility|structure|element|demo|usage|compat|related|memberOf|members|member|alpha|beta|experimental|internal|public|stable))\\b",
      "name": "storage.type.class.cssdoc"
    },
    "structure-tag": {
      "begin": "(@structure)\\b",
      "beginCaptures": {
        "1": {
          "name": "storage.type.class.cssdoc"
        }
      },
      "end": "(?=@)|(?=\\*/)",
      "patterns": [
        {
          "match": "((?:@component|@variant|@modifier|@state|@part))\\b[ \\t]*((?<ref>(?<identifier>[a-zA-Z_\\u0080-\\uFFFF][\\w\\-\\u0080-\\uFFFF]*)(?::(?<card>(?:(?<oomKw>one-or-more|more):max-(?<oomMax>[0-9]+)|max-(?<max>[0-9]+)|(?<kw>optional|opt|many|one-or-more|more))))?))?",
          "captures": {
            "1": {
              "name": "storage.type.class.cssdoc"
            },
            "2": {
              "name": "storage.type.class.cssdoc"
            }
          }
        },
        {
          "match": "\\bslot\\b",
          "name": "entity.other.attribute-name.part.cssdoc"
        },
        {
          "match": ":[a-z]+|:max-\\d+",
          "name": "variable.other.modifier.cssdoc"
        },
        {
          "match": "\\.?[A-Za-z](?:[A-Za-z0-9\\-_])*",
          "name": "entity.other.attribute-name.part.cssdoc"
        },
        {
          "match": "[{}]",
          "name": "punctuation.section.structure.cssdoc"
        }
      ]
    },
    "custom-property": {
      "match": "(?![\\w-])--[A-Za-z][A-Za-z0-9\\-_]*",
      "name": "support.type.custom-property.cssdoc"
    }
  }
}
